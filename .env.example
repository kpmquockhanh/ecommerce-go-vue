# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce?sslmode=disable

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# S3 Storage Configuration (MinIO or AWS S3)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ecommerce-images
S3_USE_SSL=false

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# SMTP / Email Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@eshop.com
FROM_NAME=eShop

# Server Configuration (optional)
# PORT=4242

# Example Stripe Keys (replace with your actual keys)
# Test Mode:
# STRIPE_SECRET_KEY=sk_test_51...
# 
# Live Mode (Production):
# STRIPE_SECRET_KEY=sk_live_51...

# Notes:
# - Never commit your actual Stripe keys to version control
# - Use test keys during development
# - Use live keys only in production
# - Keep your secret keys secure and private
